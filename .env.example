# =============================================
# Copy this file to .env.local and fill values
# =============================================

# Next Auth
AUTH_SECRET="your-random-secret-min-32-chars"
AUTH_URL="http://localhost:3000"

# Google OAuth (from console.cloud.google.com)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# App URL (localhost for dev, your domain for prod)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase / Postgres — Transaction mode (pgBouncer) for runtime queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Supabase / Postgres — Session mode for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Google Gemini AI
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
